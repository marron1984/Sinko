---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'published');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// Resolve related articles
const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const relatedArticles = article.data.relatedArticles
  .map((slug: string) => {
    const found = allArticles.find((a) => a.id === slug);
    return found ? { title: found.data.title, slug: found.id, category: found.data.category } : null;
  })
  .filter(Boolean) as { title: string; slug: string; category: string }[];
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  summary={article.data.summary}
  category={article.data.category}
  tags={article.data.tags}
  author={article.data.author}
  publishedAt={article.data.publishedAt}
  updatedAt={article.data.updatedAt}
  sources={article.data.sources}
  facts={article.data.facts}
  unverified={article.data.unverified}
  editorNote={article.data.editorNote}
  sensitive={article.data.sensitive}
  relatedArticles={relatedArticles}
  series={article.data.series}
  rawContent={article.body ?? ''}
  ogImage={article.data.ogImage}
>
  <Content />
</ArticleLayout>
