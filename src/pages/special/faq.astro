---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { getCollection, render } from 'astro:content';
import { buildJsonLdFAQ } from '@/lib/seo';

const faqs = await getCollection('faq');
const sorted = faqs.sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  sorted.map(async (faq) => {
    const { Content } = await render(faq);
    return { faq, Content };
  })
);

const faqJsonLdItems = rendered.map(({ faq }) => ({
  question: faq.data.question,
  answer: faq.body ?? '',
}));
---

<BaseLayout
  title="よくある質問（FAQ）"
  description="新興宗教・カルト問題についてよく寄せられる質問と回答をまとめています。"
  jsonLd={buildJsonLdFAQ(faqJsonLdItems)}
>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumb items={[{ label: 'FAQ' }]} />
    <h1 class="mb-2 font-serif text-2xl font-bold text-navy-900 dark:text-ivory-50">よくある質問（FAQ）</h1>
    <p class="mb-8 text-navy-600 dark:text-navy-400">
      新興宗教・カルト問題についてよく寄せられる質問と回答です。
    </p>

    <div class="space-y-6">
      {rendered.map(({ faq, Content }) => (
        <details class="group rounded-lg border border-navy-100 bg-white dark:border-navy-700 dark:bg-navy-800/50">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 font-medium text-navy-900 dark:text-ivory-50">
            <span class="pr-4">{faq.data.question}</span>
            <svg class="h-5 w-5 flex-shrink-0 text-navy-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="prose border-t border-navy-100 px-5 py-4 text-sm dark:border-navy-700">
            <Content />
          </div>
        </details>
      ))}
    </div>
  </div>
</BaseLayout>
