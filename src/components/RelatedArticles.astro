---
interface RelatedArticle {
  title: string;
  slug: string;
  category: string;
}

interface Props {
  articles: RelatedArticle[];
  title?: string;
}

const { articles, title = '関連記事' } = Astro.props;
---

{articles.length > 0 && (
  <section class="mt-8 rounded-lg border border-navy-100 bg-ivory-100/50 p-5 dark:border-navy-700 dark:bg-navy-800/30" aria-label={title}>
    <h2 class="mb-3 font-serif text-base font-bold text-navy-900 dark:text-ivory-50">{title}</h2>
    <ul class="space-y-2">
      {articles.map((article) => (
        <li>
          <a
            href={`/articles/${article.slug}/`}
            class="flex items-start gap-2 text-sm text-navy-700 hover:text-navy-900 dark:text-navy-300 dark:hover:text-ivory-100"
          >
            <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full bg-navy-400" aria-hidden="true"></span>
            {article.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
