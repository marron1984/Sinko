---
import { getCategoryById } from '@/lib/categories';
import { formatDate } from '@/lib/utils';

interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  summary?: string[];
}

const { title, description, slug, category, publishedAt, updatedAt, tags = [], summary = [] } = Astro.props;
const cat = getCategoryById(category as any);
---

<article class="group rounded-lg border border-navy-100 bg-white p-5 transition-shadow hover:shadow-md dark:border-navy-700 dark:bg-navy-800/50">
  <div class="mb-2 flex items-center gap-2">
    {cat && (
      <a
        href={`/categories/${cat.slug}/`}
        class="rounded-sm bg-navy-50 px-2 py-0.5 text-xs font-medium text-navy-600 hover:bg-navy-100 dark:bg-navy-700 dark:text-navy-300 dark:hover:bg-navy-600"
      >
        {cat.name}
      </a>
    )}
    <time datetime={publishedAt.toISOString()} class="text-xs text-navy-400 dark:text-navy-500">
      {formatDate(publishedAt)}
    </time>
    {updatedAt && (
      <span class="text-xs text-navy-400 dark:text-navy-500">
        （更新: {formatDate(updatedAt)}）
      </span>
    )}
  </div>

  <h3 class="mb-2 font-serif text-lg font-bold leading-snug text-navy-900 dark:text-ivory-50">
    <a href={`/articles/${slug}/`} class="hover:text-navy-600 dark:hover:text-navy-300">
      {title}
    </a>
  </h3>

  {summary.length > 0 && (
    <ul class="mb-3 space-y-0.5 border-l-2 border-navy-200 pl-3 dark:border-navy-600">
      {summary.map((s) => (
        <li class="text-sm text-navy-600 dark:text-navy-400">{s}</li>
      ))}
    </ul>
  )}

  <p class="text-sm leading-relaxed text-navy-600 dark:text-navy-400">
    {description}
  </p>

  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.slice(0, 4).map((tag) => (
        <a
          href={`/tags/${tag}/`}
          class="rounded-sm bg-ivory-200 px-2 py-0.5 text-xs text-navy-500 hover:bg-ivory-300 dark:bg-navy-700 dark:text-navy-400 dark:hover:bg-navy-600"
        >
          #{tag}
        </a>
      ))}
    </div>
  )}
</article>
